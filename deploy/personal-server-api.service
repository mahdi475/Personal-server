# systemd service for the Personal Server API (FastAPI + Uvicorn).
# Installed to /etc/systemd/system/personal-server-api.service

[Unit]
Description=Personal Server API (FastAPI + Uvicorn)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
User=mahdi
Group=mahdi
WorkingDirectory=/home/mahdi/personal-server/backend
ExecStart=/home/mahdi/personal-server/backend/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8000 --root-path /api
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
